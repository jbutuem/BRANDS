NEXT_PUBLIC_SUPABASE_URL=https://akahkfstgicfamfsibvw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# usada só no servidor (ingestão, responses, knowledge_gaps)
SUPABASE_SERVICE_ROLE_KEY=
# fase 3: chave do provedor de IA
ANTHROPIC_API_KEY=

# ---- Integração Instagram (Business Login for Instagram) ----
# URL pública do app, sem barra final. Usada para montar o redirect_uri do OAuth.
NEXT_PUBLIC_APP_URL=https://brands-eta-one.vercel.app
# ATENÇÃO: são o App ID e o Secret do INSTAGRAM, não os do app Facebook.
# Painel > Instagram > Configuração da API com login do Instagram.
META_APP_ID=
META_APP_SECRET=
# String inventada; tem que ser idêntica à cadastrada no webhook do painel
META_VERIFY_TOKEN=
# Opcional: fixa a versão da Graph API (padrão v26.0)
META_GRAPH_VERSION=v26.0

# ---- Varredura por API (/api/meta/scan) ----
# Protege o endpoint. Enviar em x-scan-secret ou ?secret=
# O webhook de comments exige Advanced Access; a varredura roda em Standard,
# então hoje é ela que alimenta a Fila.
SCAN_SECRET=
